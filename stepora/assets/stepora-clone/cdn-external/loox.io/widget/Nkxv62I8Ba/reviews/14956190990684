				items.forEach(item => grid.appendChild(item));

				images(items);

				if (reset) msnry.prepended(items);
				else msnry.appended(items);

				msnry.layout();

				setTimeout(function () {
					const firstItem = items[0];
					if (firstItem) {
						const gridItem = firstItem.querySelector('.grid-item');

						const isFirstPageTabChange = tab && page === 1;

						if (gridItem) {
							if (isFirstPageTabChange && newSummariesWidget) {
								newSummariesWidget.focus()
							} else {
								gridItem.focus();
							}
						}
					}
				}, 0);

				if (reset) document.dispatchEvent(new CustomEvent('iframe-resize'));

				const nextButton = html.querySelector('#loadMore');
				if (!nextButton) {
					if (self) self.style.display = 'none';
				} else {
					if (self) {
						if (!items.length) {
							self.style.display = 'none';
						} else {
							const dataUrl = nextButton.getAttribute('data-url');
							if(dataUrl) {
								self.style.display = '';
								self.setAttribute('data-url', dataUrl);
							} else {
								self.style.display = 'none';
							}
						}
					}
				}

				if (page > 10 && window.innerWidth > 600) {
					const goTopElement = document.querySelector('#goTop');
					if (goTopElement) goTopElement.style.display = '';
				}

				if (self) self.blur();

				if (tab) {
					const header = html.querySelector('#header');

					if (header) {
						if (tab === 'product') {
							productHeader = header;
						}

						if (tab === 'store') {
							storeHeader = header;
						}
					}

					const beTheFirstEl = document.querySelector('.bk-text');
					const newBeTheFirstEl = html.querySelector('.bk-text');

					if (beTheFirstEl) {
						beTheFirstEl.replaceWith(newBeTheFirstEl);
					}


					reRenderHeader();

					// Handle reviews-summaries widget visibility based on response
					const existingSummariesWidget = document.querySelector('loox-reviews-summaries-widget');

					if (newSummariesWidget && !existingSummariesWidget) {
						// Load script if not already loaded
						if (!isReviewsSummariesScriptLoaded) {
							const dataScript = html.querySelector('#loox-reviews-summaries-data');
							if (dataScript) {
								const newDataScript = document.createElement('script');
								newDataScript.textContent = dataScript.textContent;
								document.head.appendChild(newDataScript);
							}

							const widgetScript = html.querySelector('#loox-reviews-summaries-script');
							if (widgetScript) {
								const newWidgetScript = document.createElement('script');
								newWidgetScript.textContent = widgetScript.textContent;
								document.head.appendChild(newWidgetScript);
							}

							isReviewsSummariesScriptLoaded = true;
						}
						newSummariesWidget.classList.add('entering');
						grid.parentNode.insertBefore(newSummariesWidget, grid);
						setTimeout(() => newSummariesWidget.classList.remove('entering'), 400);
					} else if (!newSummariesWidget && existingSummariesWidget) {
						existingSummariesWidget.remove();
					}
				}

				if (typeof resetBadgesTooltip === "function") {
					resetBadgesTooltip()
				}

				loadMoreInProgress = false;
			});
	};
})(window);
