	var loaded = false;
	document.addEventListener('iframe-has-height', function () {
		var widgetFont = 'Poppins';

		var init = function () {
			loaded = true;
			document.dispatchEvent(new CustomEvent('font-loaded'));
			document.body.className = "grid-active";
		};

		var delayedInit = function() {
			setTimeout(function() {
				init();
			}, 0);
		}

		if (typeof Promise === "function") {
			if(document.fonts && document.fonts.ready) {
				return document.fonts.ready.then(delayedInit, delayedInit);
			}

			return new FontFaceObserver(widgetFont).load().then(delayedInit, delayedInit);
		}

		setTimeout(function () {
			if (loaded) return;
			init();
		}, 1000);
	});

	document.addEventListener('iframe-resize', function () {
		var height = document.getElementsByTagName('html')[0].offsetHeight;
		window.parent.postMessage(JSON.stringify({
			type: 'resize',
			height: height,
			frame: frameId
		}), "*");
	});

	document.onreadystatechange = function () {
		if (document.readyState !== 'complete') return;
		var h = 0;
		var has_height = false;

		setInterval(function () {
			var { offsetHeight } = document.getElementsByTagName('html')[0];

			if (offsetHeight > 0 && !has_height) {
				has_height = true;
				document.dispatchEvent(new CustomEvent('iframe-has-height'));
			}

			if ((h < offsetHeight || Math.abs(offsetHeight - h) >= 50) && !LOOX.inHcpModalMode) {
				h = offsetHeight;
				window.parent.postMessage(JSON.stringify({ type: 'resize', height: h, frame: frameId }), "*");
			}
		}, 100);
	};
})();

